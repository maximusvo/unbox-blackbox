<!doctype html>
<html lang="{{ site.lang | default: 'de' | slice: 0, 2 }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" href="{{ '/favicon.svg' | relative_url }}" type="image/svg+xml">
  <link rel="alternate icon" href="{{ '/favicon.ico' | relative_url }}">
  <link rel="stylesheet" href="{{ '/assets/css/main.css' | relative_url }}">
  <meta name="keywords" content="{{ site.keywords | join: ', ' }}">
  {% feed_meta %}
  {% seo %}
</head>
<body>
{% include header.liquid %}
<main class="page">
  {{ content }}
</main>
{% include footer.liquid %}
<script src="{{ '/assets/js/main.js' | relative_url }}"></script>
{% if page.url == '/' %}<script src="{{ '/assets/js/drill-hero.js' | relative_url }}"></script>{% endif %}
</body>
</html>
