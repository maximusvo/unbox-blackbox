---
layout: default
---
<article class="post-single">
  <div class="post-single-inner">
    <div class="post-single-meta">
      {% if page.date %}<time datetime="{{ page.date | date_to_xmlschema }}">{{ page.date | date: '%d.%m.%Y' }}</time>{% endif %}
      {% for cat in page.categories %}<span class="teaser-cat cat-{{ cat | slugify }}">{{ cat }}</span>{% endfor %}
    </div>
    <h1 class="post-single-title">{{ page.title }}</h1>
    {% if page.target %}<p class="post-single-source">Erschienen bei: {{ page.target }}</p>{% endif %}

    <div class="post-single-figure">
      <img src="{{ '/assets/img/teasers/' | append: page.slug | append: '.svg' | relative_url }}" alt="">
    </div>

    {% if page.teaser %}<p class="post-single-teaser">{{ page.teaser }}</p>{% endif %}

    <div class="post-single-content">
      {{ content }}
    </div>

    {% if page.externalurl %}
    <p class="post-single-external">
      Dieser Inhalt ist extern bei {{ page.target }} erschienen und wird hier nur verlinkt.
      <a href="{{ page.externalurl }}" target="_blank" rel="noopener">Zur Originalquelle &#8599;</a>
    </p>
    {% endif %}

    <p class="post-single-back"><a href="{{ '/#archiv' | relative_url }}">&larr; Zurück zur Übersicht</a></p>
  </div>
</article>
